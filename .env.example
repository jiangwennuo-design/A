# ── 客户端可见（会进入前端包，只放公开值）─────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Discord 登录开关（"true" 时显示 Discord 登录按钮）
VITE_ENABLE_DISCORD_LOGIN=false

# ── 仅服务端（不要加 VITE_ 前缀，不会进入前端包）─────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 用户自备 AI API Key 的加密主密钥（AES-GCM）。
# 仅服务端使用；丢失后已保存的 API Key 无法解密，需要用户重新填写。
AI_CONFIG_ENCRYPTION_KEY=

# 内置 AI（Lovable AI Gateway）。用户未配置自己的 AI 时作为兜底。
LOVABLE_API_KEY=

# 可选：项目级自备 AI 渠道（仍为兜底，优先级低于用户自己的 AI 配置）
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=
